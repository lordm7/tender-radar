# Copy to .env (never commit .env). Defaults work without any key: the "fake" AI.
TR_DATABASE_URL=sqlite:///tender_radar.db
TR_AI_PROVIDER=fake
# To use Gemini's free tier: get a key at https://aistudio.google.com/apikey
# and pick a current free-tier model from Google's model list after running scripts/ai_smoke_test.py
GEMINI_API_KEY=
TR_GEMINI_MODEL=
# Optional daily email digest (sent only to you). Gmail: create an "app password"
# (Google account > Security > App passwords) and paste it below yourself.
TR_SMTP_HOST=
TR_SMTP_PORT=587
TR_SMTP_USER=
TR_SMTP_PASSWORD=
TR_DIGEST_TO=
